# This is a sample .env file for reference
# Actual environment variables should be set in the Vercel dashboard

# MongoDB Connection String
URI=mongodb+srv://username:password@cluster.mongodb.net/database-name

# JWT Secret
JWT_SECRET=your-jwt-secret

# Port (will be provided by Vercel in production)
PORT=5000

# Node Environment
NODE_ENV=production

# Optional: Email configuration for notifications
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
